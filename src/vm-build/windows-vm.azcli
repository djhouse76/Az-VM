# Public template: replace placeholder values for your environment.
mySubs="00000000-0000-0000-0000-000000000000"
location=uksouth
RG=win-vm-rg

# Set Azure Account
az account set --subscription $mySubs

# Create Resource Group
az group create -l $location -n $RG

# Variables

# Microsoft Win 11 - nested virtualisation (WSL compatible)
image=microsoftvisualstudio:windowsplustools:base-win11-gen2:latest
vmName=winVM
pip=vm-pip
vnetRG=vnet-rg
vnetName=vnet
subnetName=default
#Standard_B4ms
vmsize=Standard_D4s_v3
adminUsername=<admin-username>
adminPassword=<strong-password>

# create a public ip
az network public-ip create -g $RG -l $location -n $pip --sku Standard

# Get VNET subnet resource ID
SNET_ID=$(az network vnet subnet show -n $subnetName --vnet-name $vnetName --resource-group $vnetRG --query id -o tsv)
echo $SNET_ID

# Create Azure Windows VM within private VNET
az vm create -n $vmName -g $RG \
    --image $image \
    -l $location \
    --size $vmsize \
    --authentication-type password \
    --admin-username $adminUsername \
    --admin-password $adminPassword \
    --public-ip-address $pip \
    --subnet $SNET_ID


# Clean up resources
az group delete --name $RG --yes --no-wait